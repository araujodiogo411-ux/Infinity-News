rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    match /articles/{articleId} {
      allow read: if true;
      allow write: if isValidId(articleId);
    }

    match /quotes/{quoteId} {
      allow read: if true;
      allow write: if isValidId(quoteId);
    }

    match /brasilia_photos/{photoId} {
      allow read: if true;
      allow write: if isValidId(photoId);
    }
  }
}
